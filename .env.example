# API server
API_PORT=4417

# LLM (OpenAI-compatible). Leave empty to use the offline rule-based brain.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Text-to-speech. "browser" uses Windows voices via Web Speech API (offline, free).
# "openai" uses an OpenAI-compatible /audio/speech endpoint.
TTS_PROVIDER=browser
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_VOICE=alloy

# TikTok: only official, approved APIs. Leave empty = manual mode (operator types/pastes viewer questions).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
