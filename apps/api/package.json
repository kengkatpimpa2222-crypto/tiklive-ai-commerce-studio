    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "@tlai/ai": "workspace:*",
    "@tlai/compliance": "workspace:*",
    "@tlai/shared": "workspace:*",
    "@tlai/tiktok": "workspace:*",
    "@tlai/tts": "workspace:*",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "@types/ws": "^8.5.13"
  }
}
