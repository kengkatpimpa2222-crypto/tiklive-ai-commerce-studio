{
  "name": "@tlai/desktop",
  "productName": "TikLive AI Commerce Studio",
  "version": "0.22.0",
  "private": true,
  "description": "AI virtual live seller studio for TikTok LIVE (official channels only).",
  "main": "out/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node build.mjs && electron .",
    "package:win": "node build.mjs && electron-builder --win nsis --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "@tlai/api": "workspace:*",
    "@tlai/shared": "workspace:*",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "electron-updater": "6.3.9"
  },
  "build": {
    "appId": "studio.tiklive.ai-commerce",
    "productName": "TikLive AI Commerce Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../studio/dist",
        "to": "studio"
      },
      {
        "from": "../../.env.example",
        "to": ".env.example"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TikLive-AI-Commerce-Studio-Setup-${version}.exe"
    },
    "npmRebuild": false,
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "kengkatpimpa2222-crypto",
      "repo": "tiklive-ai-commerce-studio",
      "releaseType": "release"
    }
  },
  "author": "TikLive AI Commerce Studio"
}
